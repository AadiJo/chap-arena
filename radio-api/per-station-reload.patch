+// An abbreviated hostapd config the way QSDK's hostapd.sh writes one for an AP interface. ignore_broadcast_ssid is there
+// to catch a rewrite that matches "ssid=" anywhere in a line.
+func hostapdConfig(wifiInterface, vlan, ssid, wpaKey string) string {
+	return fmt.Sprintf(
+		"driver=nl80211\ninterface=%s\nctrl_interface=/var/run/hostapd-wifi1\nssid=%s\nbridge=br-%s\nwpa=2\n"+
+			"wpa_passphrase=%s\nwpa_key_mgmt=WPA-PSK SAE\nsae_password=%s\nignore_broadcast_ssid=0\n",
+		wifiInterface, ssid, vlan, wpaKey, wpaKey,
+	)
+}
+
+func readHostapdConfig(t *testing.T, wifiInterface string) string {
+	config, err := os.ReadFile(hostapdConfigPath(wifiInterface))
+	assert.Nil(t, err)
+	return string(config)
+}
+
+func hostapdControlCommand(command string) string {
+	return "wpa_cli -g /var/run/hostapd/global raw " + command
+}
+
+func setIwinfoSsid(fakeShell *fakeShell, wifiInterface, ssid string) {
+	fakeShell.commandOutput["iwinfo "+wifiInterface+" info"] = fmt.Sprintf("%s\nESSID: \"%s\"\n", wifiInterface, ssid)
+}
