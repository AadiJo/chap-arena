+// What newRunningVividHosting starts each station with.
+var runningStations = map[string]StationConfiguration{
+	"red1":  {Ssid: "1111", WpaKey: "11111111"},
+	"red3":  {Ssid: "3333", WpaKey: "33333333"},
+	"blue3": {Ssid: "6666", WpaKey: "66666666"},
+}
+
+// Sets up a VH-113 already running runningStations on channel 5 at 40MHz: uci and each interface's hostapd config (in a
+// temp directory standing in for /var/run) describe them, and iwinfo reports their SSIDs. Puts the package's fakes and
+// settings back afterward.
+func newRunningVividHosting(t *testing.T) (*Radio, *fakeUciTree, *fakeShell) {
+	oldUciTree, oldShell, oldHostapdConfigDir := uciTree, shell, hostapdConfigDir
+	oldRetryBackoff, oldReloadBackoff := retryBackoffDuration, wifiReloadBackoffDuration
+	t.Cleanup(func() {
+		uciTree, shell, hostapdConfigDir = oldUciTree, oldShell, oldHostapdConfigDir
+		retryBackoffDuration, wifiReloadBackoffDuration = oldRetryBackoff, oldReloadBackoff
+	})
+
+	fakeTree := newFakeUciTree()
+	uciTree = fakeTree
+	fakeTree.valuesForGet["system.@system[0].model"] = "VH-113"
+	fakeShell := newFakeShell(t)
+	shell = fakeShell
+	fakeShell.commandOutput["cat /etc/vh_firmware"] = ""
+	hostapdConfigDir = t.TempDir()
+	retryBackoffDuration = 10 * time.Millisecond
+	wifiReloadBackoffDuration = 10 * time.Millisecond
+	radio := NewRadio()
+	delete(fakeShell.commandsRun, "cat /etc/vh_firmware")
+
+	fakeTree.valuesForGet["wireless.wifi1.channel"] = "5"
+	fakeTree.valuesForGet["wireless.wifi1.htmode"] = "HT40"
+	for station := red1; station <= blue3; station++ {
+		wifiInterface := radio.stationInterfaces[station]
+		ssid, wpaKey := stationSsidAndKey(runningStations, station)
+		vlan := fmt.Sprintf("vlan%d", radio.getStationVlan(station))
+		section := fmt.Sprintf("wireless.@wifi-iface[%d]", int(station)+1)
+		fakeTree.valuesForGet[section+".ssid"] = ssid
+		fakeTree.valuesForGet[section+".key"] = wpaKey
+		fakeTree.valuesForGet[section+".network"] = vlan
+		config := hostapdConfig(wifiInterface, vlan, ssid, wpaKey)
+		assert.Nil(t, os.WriteFile(hostapdConfigPath(wifiInterface), []byte(config), 0644))
+		setIwinfoSsid(fakeShell, wifiInterface, ssid)
+	}
+	return radio, fakeTree, fakeShell
+}
