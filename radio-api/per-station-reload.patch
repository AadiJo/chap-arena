+// A "wifi reload" on the VH-113's Qualcomm firmware deletes and recreates every interface on the radio, kicking every
+// robot off. These tests cover restarting only the stations whose SSID or WPA key changes, and every case that has to
+// fall back to the full reload: the channel, bandwidth or VLANs changing, a missing or unexpected hostapd config,
+// hostapd refusing to remove or re-add the interface, and the new SSID not taking.
+
+func TestRadio_configureVividHostingRestartsOnlyChangedStations(t *testing.T) {
+	radio, fakeTree, fakeShell := newRunningVividHosting(t)
+
+	// Red 3 gets a new team and blue 3 is emptied; red 1 keeps its team.
+	fakeShell.commandOutput[hostapdControlCommand("REMOVE ath12")] = "OK\n"
+	fakeShell.commandOutput[hostapdControlCommand("ADD bss_config=ath12:"+hostapdConfigPath("ath12"))] = "OK\n"
+	fakeShell.commandOutput[hostapdControlCommand("REMOVE ath15")] = "OK\n"
+	fakeShell.commandOutput[hostapdControlCommand("ADD bss_config=ath15:"+hostapdConfigPath("ath15"))] = "OK\n"
+	setIwinfoSsid(fakeShell, "ath12", "3456")
+	setIwinfoSsid(fakeShell, "ath15", "no-team-6")
+	request := ConfigurationRequest{
+		Channel: 5,
+		StationConfigurations: map[string]StationConfiguration{
+			"red1": {Ssid: "1111", WpaKey: "11111111"},
+			"red3": {Ssid: "3456", WpaKey: "34563456"},
+		},
+	}
+	assert.Nil(t, radio.handleConfigurationRequest(request))
+
+	// Only red 3 and blue 3 were restarted; the fake shell fails the test on any other command, like "wifi reload".
+	assert.Equal(t, 10, len(fakeShell.commandsRun))
+	assert.Equal(t, hostapdConfig("ath12", "vlan30", "3456", "34563456"), readHostapdConfig(t, "ath12"))
+	assert.Equal(t, hostapdConfig("ath15", "vlan60", "no-team-6", "no-team-6"), readHostapdConfig(t, "ath15"))
+	assert.Equal(t, hostapdConfig("ath1", "vlan10", "1111", "11111111"), readHostapdConfig(t, "ath1"))
+	assert.Equal(t, hostapdConfig("ath11", "vlan20", "no-team-2", "no-team-2"), readHostapdConfig(t, "ath11"))
+
+	// uci matches, so a later full reload or reboot comes up the same.
+	assert.Equal(t, "3456", fakeTree.valuesFromSet["wireless.@wifi-iface[3].ssid"])
+	assert.Equal(t, "34563456", fakeTree.valuesFromSet["wireless.@wifi-iface[3].key"])
+	assert.Equal(t, "34563456", fakeTree.valuesFromSet["wireless.@wifi-iface[3].sae_password"])
+	assert.Equal(t, "no-team-6", fakeTree.valuesFromSet["wireless.@wifi-iface[6].ssid"])
+	assert.NotContains(t, fakeTree.valuesFromSet, "wireless.@wifi-iface[1].ssid")
+	assert.Greater(t, fakeTree.commitCount, 0)
+
+	assert.Equal(t, "1111", radio.StationStatuses["red1"].Ssid)
+	assert.Equal(t, "3456", radio.StationStatuses["red3"].Ssid)
+	assert.Nil(t, radio.StationStatuses["blue3"])
+}
