+// configureChangedStations applies the station configurations by restarting hostapd on only the interfaces whose SSID
+// or WPA key changes, so robots on the other stations stay connected. A "wifi reload" on the VH-113's Qualcomm firmware
+// deletes and recreates every interface on the radio, which kicks every robot off. Returns false if the configuration
+// still needs that full reload: a station's VLAN changes, a restart fails, or the SSIDs don't match afterward. Any
+// stations it already restarted are saved in uci, so configureStations picks up where it left off.
+func (radio *Radio) configureChangedStations(stationConfigurations map[string]StationConfiguration) bool {
+	var changed []station
+	for station := red1; station <= blue3; station++ {
+		section := fmt.Sprintf("@wifi-iface[%d]", int(station)+1)
+		network, _ := uciTree.GetLast("wireless", section, "network")
+		if network != fmt.Sprintf("vlan%d", radio.getStationVlan(station)) {
+			return false
+		}
+		ssid, wpaKey := stationSsidAndKey(stationConfigurations, station)
+		currentSsid, _ := uciTree.GetLast("wireless", section, "ssid")
+		currentWpaKey, _ := uciTree.GetLast("wireless", section, "key")
+		if currentSsid != ssid || currentWpaKey != wpaKey {
+			changed = append(changed, station)
+		}
+	}
+
+	for _, station := range changed {
+		ssid, wpaKey := stationSsidAndKey(stationConfigurations, station)
+		section := fmt.Sprintf("@wifi-iface[%d]", int(station)+1)
+		uciTree.SetType("wireless", section, "ssid", uci.TypeOption, ssid)
+		uciTree.SetType("wireless", section, "key", uci.TypeOption, wpaKey)
+		uciTree.SetType("wireless", section, "sae_password", uci.TypeOption, wpaKey)
+		if err := uciTree.Commit(); err != nil {
+			log.Printf("Failed to commit wireless configuration for %s: %v", station, err)
+			return false
+		}
+		if err := restartHostapd(radio.stationInterfaces[station], ssid, wpaKey); err != nil {
+			log.Printf("Couldn't restart %s on its own (%v); reloading all of Wi-Fi instead.", station, err)
+			return false
+		}
+	}
+	if len(changed) > 0 {
+		time.Sleep(wifiReloadBackoffDuration)
+	}
+
+	if err := radio.updateStationStatuses(); err != nil {
+		log.Printf("Error updating station statuses (%v); reloading all of Wi-Fi.", err)
+		return false
+	}
+	if !radio.stationSsidsAreCorrect(stationConfigurations) {
+		log.Printf("Wi-Fi configuration incorrect after restarting %v; reloading all of Wi-Fi.", changed)
+		return false
+	}
+	log.Printf("Configured Wi-Fi by restarting only %v.", changed)
+	return true
+}
+
+// stationSsidAndKey returns the SSID and WPA key the given station should have: its team's, or a placeholder that
+// leaves the station unused.
+func stationSsidAndKey(stationConfigurations map[string]StationConfiguration, station station) (string, string) {
+	if config, ok := stationConfigurations[station.String()]; ok {
+		return config.Ssid, config.WpaKey
+	}
+	placeholder := fmt.Sprintf("no-team-%d", int(station)+1)
+	return placeholder, placeholder
+}
+
+// Directory where QSDK's hostapd.sh writes each interface's config (hostapd-<interface>.conf), and the control socket
+// it adds and removes interfaces through. Each interface is its own hostapd entry, so one can be restarted alone.
+var hostapdConfigDir = "/var/run"
+
+const hostapdGlobalControl = "/var/run/hostapd/global"
+
+func hostapdConfigPath(wifiInterface string) string {
+	return filepath.Join(hostapdConfigDir, fmt.Sprintf("hostapd-%s.conf", wifiInterface))
+}
+
+// restartHostapd puts the new SSID and WPA key into the given interface's hostapd config, then removes the interface
+// from hostapd and adds it back the way QSDK's hostapd.sh does. The config file is checked before hostapd is touched.
+// Request validation keeps SSIDs and keys to plain alphanumerics, so they can go into the file as is.
+func restartHostapd(wifiInterface, ssid, wpaKey string) error {
+	path := hostapdConfigPath(wifiInterface)
+	config, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	values := map[string]string{"ssid": ssid, "wpa_passphrase": wpaKey, "sae_password": wpaKey}
+	found := map[string]bool{}
+	lines := strings.Split(string(config), "\n")
+	for i, line := range lines {
+		name, _, ok := strings.Cut(line, "=")
+		if value, known := values[name]; ok && known {
+			lines[i] = name + "=" + value
+			found[name] = true
+		}
+	}
+	// sae_password is optional; hostapd.sh only writes it when SAE is on.
+	for _, name := range []string{"ssid", "wpa_passphrase"} {
+		if !found[name] {
+			return fmt.Errorf("no %s line in %s", name, path)
+		}
+	}
+	if err = os.WriteFile(path, []byte(strings.Join(lines, "\n")), 0600); err != nil {
+		return err
+	}
+
+	if err = hostapdControl("REMOVE", wifiInterface); err != nil {
+		return err
+	}
+	return hostapdControl("ADD", fmt.Sprintf("bss_config=%s:%s", wifiInterface, path))
+}
+
+// hostapdControl sends a command to hostapd's global control socket and checks that hostapd answered OK.
+func hostapdControl(command string, argument string) error {
+	output, err := shell.runCommand("wpa_cli", "-g", hostapdGlobalControl, "raw", command, argument)
+	if err != nil {
+		return fmt.Errorf("hostapd %s %s: %v", command, argument, err)
+	}
+	if reply := strings.TrimSpace(output); reply != "OK" {
+		return fmt.Errorf("hostapd %s %s: %q", command, argument, reply)
+	}
+	return nil
+}
